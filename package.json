{
  "name": "localbot-studio",
  "version": "0.9.5",
  "main": "electron/main.js",
  "description": "Criador de Bot de Discord com IA local.",
  "author": "gmauad",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "build:win": "vite build && electron-builder --win",
    "build:portable": "vite build && electron-builder --win portable",
    "release": "vite build && dotenv -e .env -- electron-builder --win --publish always",
    "release:portable": "vite build && dotenv -e .env -- electron-builder --win portable --publish always"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.6",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "com.localbotstudio.app",
    "productName": "LocalBot Studio",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gmauad",
        "repo": "localbot-studio",
        "private": true,
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/node_modules/**/{test,__tests__,tests,powered-test,example,examples}/**",
      "!**/node_modules/**/*.{md,markdown,map}",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!bin/**",
          "!python/**",
          "!**/__pycache__/**",
          "!**/*.sqlite",
          "!**/*.sqlite-wal",
          "!**/*.sqlite-shm",
          "!**/*.pcm",
          "!**/*.mp3",
          "!**/audio_*",
          "!**/*.gguf"
        ]
      },
      {
        "from": "backend/python",
        "to": "backend/python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!get-pip.py"
        ]
      },
      {
        "from": "node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/*.markdown",
          "!**/*.map",
          "!**/.bin/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/example/**",
          "!**/examples/**",
          "!**/docs/**",
          "!**/.github/**",
          "!**/*.ts",
          "!**/*.flow",
          "!**/*.coffee",
          "!**/README*",
          "!**/CHANGELOG*",
          "!**/LICENSE*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalBot Studio",
      "artifactName": "LocalBot-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LocalBot-Studio-Portable-${version}.${ext}"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/@discordjs/opus/**/*",
      "**/node_modules/opusscript/**/*"
    ]
  }
}